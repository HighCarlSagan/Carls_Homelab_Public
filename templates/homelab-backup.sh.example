#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────
# homelab-backup.sh.example
#
# Daily homelab config backup. Tarballs all critical config dirs
# to a backup location, keeps the last 7 archives.
#
# Customize:
#   BACKUP_DIR   — where archives are stored
#   The tar list  — paths specific to your install
#
# Add to crontab:
#   PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
#   SHELL=/bin/bash
#   0 2 * * * /path/to/homelab-backup.sh >> /var/log/homelab-backup.log 2>&1
# ─────────────────────────────────────────────────────────────────

set -euo pipefail

BACKUP_DIR="/srv/filebrowser/backups"
DATE=$(date +%Y-%m-%d)
ARCHIVE="$BACKUP_DIR/homelab-configs-$DATE.tar.gz"
USER_HOME="${HOME:-/home/<your-user>}"

mkdir -p "$BACKUP_DIR"

tar -czf "$ARCHIVE" \
  /etc/caddy/Caddyfile \
  /etc/authelia/configuration.yml \
  /etc/authelia/users.yml \
  /etc/cloudflared/config.yml \
  /etc/mosquitto/mosquitto.conf \
  /etc/homeassistant/configuration.yaml \
  /etc/filebrowser/filebrowser.db \
  /etc/pihole \
  "$USER_HOME/.cloudflared" \
  "$USER_HOME/homelab-configs" \
  2>/dev/null || true

# Keep last 7 archives
ls -t "$BACKUP_DIR"/homelab-configs-*.tar.gz | tail -n +8 | xargs rm -f 2>/dev/null || true

echo "[$(date)] Backup complete: $ARCHIVE ($(du -sh $ARCHIVE | cut -f1))"
